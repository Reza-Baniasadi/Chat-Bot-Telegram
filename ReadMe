# database command for create requirement

!sudo su
!curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add -
!curl https://packages.microsoft.com/config/ubuntu/20.04/prod.list > /etc/apt/sources.list.d/mssql-release.list
!exit

!sudo apt-get update
!sudo ACCEPT_EULA=Y apt-get install msodbcsql17
!sudo apt-get install unixodbc-dev


#package linux

!sudo rm -rf /var/cache/apt/archives/*.deb

!sudo apt update

!wget https://packages.microsoft.com/ubuntu/20.04/prod/pool/main/u/unixodbc/odbcinst_2.3.11-1_amd64.deb
!wget https://packages.microsoft.com/ubuntu/20.04/prod/pool/main/u/unixodbc/odbcinst1debian2_2.3.11-1_amd64.deb
!wget https://packages.microsoft.com/ubuntu/20.04/prod/pool/main/u/unixodbc/libodbc1_2.3.11-1_amd64.deb

!sudo dpkg -i --force-overwrite odbcinst_2.3.11-1_amd64.deb
!sudo dpkg -i --force-overwrite odbcinst1debian2_2.3.11-1_amd64.deb
!sudo dpkg -i --force-overwrite libodbc1_2.3.11-1_amd64.deb

#sql linux command

!sudo apt install -y unixodbc unixodbc-dev

!sudo ACCEPT_EULA=Y apt install -y msodbcsql17